{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart21network",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./www",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": {
    // Leave empty: the Worker tries llama-3.3-70b, glm-4.7-flash and gemma-4 in order. (Cloudflare retired llama-3.1-8b on 2026-05-30.)
    "AI_MODEL": "",
    // "" = any website or app may use the AI (needed for the Android app and the Windows app).
    // To limit it, list the addresses: "https://smart21network.smart21brain.com,https://localhost"
    "ALLOWED_ORIGINS": ""
  }
}
